LangString addOrReinstall ${LANG_UZBEK} "Komponentlarni qoʻshish yoki qayta oʻrnatish"
LangString alreadyInstalled ${LANG_UZBEK} "Allaqachon oʻrnatilgan"
LangString alreadyInstalledLong ${LANG_UZBEK} "${PRODUCTNAME} ${VERSION} allaqachon oʻrnatilgan. Bajariladigan amalni tanlang va davom etish uchun «Keyingi» tugmasini bosing."
LangString appRunning ${LANG_UZBEK} "${PRODUCTNAME} ishlamoqda! Avval uni yoping, soʻng qayta urinib koʻring."
LangString appRunningOkKill ${LANG_UZBEK} "${PRODUCTNAME} ishlamoqda!$\nUni toʻxtatish uchun OK tugmasini bosing"
LangString chooseMaintenanceOption ${LANG_UZBEK} "Bajariladigan xizmat amalini tanlang."
LangString choowHowToInstall ${LANG_UZBEK} "${PRODUCTNAME} qanday oʻrnatilishini tanlang."
LangString createDesktop ${LANG_UZBEK} "Ish stolida yorliq yaratish"
LangString dontUninstall ${LANG_UZBEK} "Oʻchirmaslik"
LangString dontUninstallDowngrade ${LANG_UZBEK} "Oʻchirmaslik (bu oʻrnatuvchida oʻchirmasdan eski versiyaga qaytish oʻchirilgan)"
LangString failedToKillApp ${LANG_UZBEK} "${PRODUCTNAME} toʻxtatilmadi. Avval uni yoping, soʻng qayta urinib koʻring"
LangString installingWebview2 ${LANG_UZBEK} "WebView2 oʻrnatilmoqda..."
LangString newerVersionInstalled ${LANG_UZBEK} "${PRODUCTNAME} ning yangiroq versiyasi allaqachon oʻrnatilgan! Eski versiyani oʻrnatish tavsiya etilmaydi. Agar baribir oʻrnatmoqchi boʻlsangiz, avval joriy versiyani oʻchiring. Bajariladigan amalni tanlang va davom etish uchun «Keyingi» tugmasini bosing."
LangString older ${LANG_UZBEK} "eskiroq"
LangString olderOrUnknownVersionInstalled ${LANG_UZBEK} "Tizimingizda ${PRODUCTNAME} ning $R4 versiyasi oʻrnatilgan. Oʻrnatishdan oldin joriy versiyani oʻchirish tavsiya etiladi. Bajariladigan amalni tanlang va davom etish uchun «Keyingi» tugmasini bosing."
LangString silentDowngrades ${LANG_UZBEK} "Bu oʻrnatuvchida eski versiyaga qaytish oʻchirilgan, jim rejimda davom etib boʻlmaydi, iltimos grafik oʻrnatuvchidan foydalaning.$\n"
LangString unableToUninstall ${LANG_UZBEK} "Oʻchirib boʻlmadi!"
LangString uninstallApp ${LANG_UZBEK} "${PRODUCTNAME} ni oʻchirish"
LangString uninstallBeforeInstalling ${LANG_UZBEK} "Oʻrnatishdan oldin oʻchirish"
LangString unknown ${LANG_UZBEK} "nomaʼlum"
LangString webview2AbortError ${LANG_UZBEK} "WebView2 oʻrnatilmadi! Ilova usiz ishlay olmaydi. Oʻrnatuvchini qayta ishga tushirib koʻring."
LangString webview2DownloadError ${LANG_UZBEK} "Xato: WebView2 yuklab olinmadi - $0"
LangString webview2DownloadSuccess ${LANG_UZBEK} "WebView2 yuklovchisi muvaffaqiyatli yuklab olindi"
LangString webview2Downloading ${LANG_UZBEK} "WebView2 yuklovchisi yuklab olinmoqda..."
LangString webview2InstallError ${LANG_UZBEK} "Xato: WebView2 oʻrnatilmadi, chiqish kodi $1"
LangString webview2InstallSuccess ${LANG_UZBEK} "WebView2 muvaffaqiyatli oʻrnatildi"
LangString deleteAppData ${LANG_UZBEK} "Ilova maʼlumotlarini oʻchirish"
