{
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "default",
    "description": "Capability for the main window",
    "windows": [
        "main"
    ],
    "permissions": [
        "core:default",
        "core:event:default",
        "dialog:default",
        "dialog:allow-save",
        "fs:default",
        "fs:allow-write-file",
        {
            "identifier": "fs:allow-write",
            "allow": [
                {
                    "path": "**"
                }
            ]
        },
        {
            "identifier": "fs:allow-read",
            "allow": [
                {
                    "path": "**"
                }
            ]
        }
    ]
}