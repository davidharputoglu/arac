{
    "productName": "ASHINA",
    "version": "0.0.1",
    "identifier": "com.ashina.app",
    "build": {
        "beforeDevCommand": "npm run dev",
        "beforeBuildCommand": "npm run build",
        "devUrl": "http://localhost:1420",
        "frontendDist": "../dist"
    },
    "app": {
        "withGlobalTauri": true,
        "windows": [
            {
                "title": "Convertisseur Universel",
                "width": 1000,
                "height": 800,
                "resizable": true,
                "fullscreen": false,
                "transparent": false
            }
        ],
        "security": {
            "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' http://127.0.0.1:1420 ws://127.0.0.1:1420 blob: data:;"
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "linux": {
            "deb": {
                "depends": [
                    "alien"
                ]
            }
        }
    }
}